# Generated platform folders.
#
# `flutter create` regenerates these to match your local Flutter, Gradle and
# Xcode versions; a committed copy from another machine is a reliable source of
# build failures. Run tool/setup.sh instead. Our changes to them live in
# app/platform_patches/ and are applied by that script.
app/android/
app/ios/
app/linux/
app/macos/
app/windows/
app/web/

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store

# Regenerated by flutter create (see tool/setup.sh)
app/.metadata
app/zip_tools.iml
app/README.md
app/.gitignore
